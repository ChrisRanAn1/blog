source "https://rubygems.org"

# Track GitHub Pages' pinned dependency set so `bundle exec jekyll serve`
# locally matches what GitHub actually builds.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
  gem "jekyll-paginate"
  gem "jekyll-include-cache"
  gem "jekyll-remote-theme"
  gem "jemoji"
end

# Windows/JRuby portability — harmless on macOS/Linux
gem "wdm", "~> 0.1.1", platforms: [:mingw, :x64_mingw, :mswin]
gem "tzinfo-data", platforms: [:mingw, :x64_mingw, :mswin, :jruby]

gem "webrick", "~> 1.8"
